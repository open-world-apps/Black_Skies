// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../dist/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  ipId          Int?
  name          String        @unique @db.VarChar(30)
  nickname      String?       @db.VarChar(90)
  hashedPwd     String?       @map("hashed_pwd") @db.VarChar(100)
  email         String?       @unique
  emailVerified DateTime?     @map("email_verified")
  image         String?
  country       String?
  birthdate     DateTime?
  accounts      Account[]
  sessions      Session[]
  dossier       PilotDossier?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  banned Banned? @relation(fields: [ipId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @default(cuid()) @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PilotDossier {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  archetype String
  pilotName String  @map("pilot_name") @db.VarChar(40)
  age       Int
  heightCm  Int     @map("height_cm")
  weightKg  Int     @map("weight_kg")
  physical  String? @db.VarChar(240)
  bio       String  @db.VarChar(1400)

  skillSheet   Json     @map("skill_sheet")
  lockedTraits String[] @map("locked_traits")
  pickedTraits String[] @map("picked_traits")

  allegiance String?
  spawn      String
  registryId String  @map("registry_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pilot_dossiers")
}

model Banned {
  id        Int       @id @unique @default(autoincrement())
  ip        String?   @unique
  reason    String?
  bannedAt  DateTime  @default(now())
  expiresAt DateTime? // null = permanent
  users     User[]
}
